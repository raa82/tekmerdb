#!/usr/bin/env python3
"""
agent_tekmerdb.py -- Energy Compliance Analyst, TekmerDB backend.

Runs on the HOST machine. Spawns pfodb-mcp as a stdio subprocess,
which forwards to the pfodb HTTP engine on localhost:3000.
Uses Ollama for reasoning.

Usage:
    ./pfodb &
    python agent-tekmerdb/agent_tekmerdb.py --mcp-bin /path/to/pfodb-mcp
    python agent-tekmerdb/agent_tekmerdb.py --mcp-bin /path/to/pfodb-mcp --serve
"""

import argparse
import asyncio
import json
import logging
import os
import sys
import textwrap
from datetime import datetime
from pathlib import Path

from mcp_client import MCPClient
from ollama_client import run_agent_loop, OLLAMA_URL, OLLAMA_MODEL

logging.basicConfig(level=logging.WARNING, format="%(name)s %(levelname)s %(message)s")
log = logging.getLogger("agent_tekmerdb")

LOG_DIR = os.environ.get("LOG_DIR", "./logs")

SYSTEM_PROMPT = """You are an Energy Compliance Analyst at a European grid operator.
Your role is to answer compliance and regulatory questions using a reliability-weighted
knowledge base built from the World Energy Outlook 2025 report.

The knowledge base stores facts with confidence scores, corroboration counts,
and conflict flags. A reliability summary will be automatically appended to
your answer - you do not need to include it yourself.

Key behaviours:
- ALWAYS call the search tool before answering
- If conflict_refs is non-empty in retrieved facts, present BOTH sides of the
  contradiction explicitly in your answer
- If confidence is low (<0.6), flag the claim as unreliable in your answer
- Cite page numbers from the source field when available
- Stay in scope: energy, infrastructure, compliance only
"""

DIVIDER = "=" * 70
SEP     = "-" * 70


def cprint(text: str, prefix: str = "  "):
    for line in text.splitlines():
        for wl in (textwrap.wrap(line, 66) if line.strip() else [""]):
            print(f"{prefix}{wl}")


def confidence_bar(conf: float, width: int = 12) -> str:
    filled = round(conf * width)
    bar = "#" * filled + "." * (width - filled)
    return f"[{bar}] {conf:.3f}"


def print_tool_call(name: str, args: dict, result: str):
    print(f"\n  [TOOL] {name} {json.dumps(args)}")
    try:
        data  = json.loads(result)
        items = data if isinstance(data, list) else [data]
        for i, item in enumerate(items[:4], 1):
            conf  = item.get("confidence")
            crefs = item.get("conflict_refs", [])
            corr  = item.get("corroboration_count", 0)
            src   = item.get("source", "?")
            text  = item.get("claim_text", item.get("chunk_text", ""))[:90]
            bar   = confidence_bar(conf) if conf is not None else ""
            flag  = f"  [CONFLICT x{len(crefs)}]" if crefs else ""
            print(f"    [{i}] {bar}{flag}")
            print(f"        corroborations: {corr}  source: {src}")
            print(f"        '{text}'")
    except Exception:
        print(f"    {result[:300]}")


class TekmerAgent:

    def __init__(self, mcp_bin: str):
        self.mcp_bin = mcp_bin
        self._mcp:   MCPClient | None = None
        self._tools: list[dict]       = []
        self._ready: bool             = False
        Path(LOG_DIR).mkdir(parents=True, exist_ok=True)

    async def start(self):
        log.info(f"Spawning pfodb-mcp: {self.mcp_bin}")
        self._mcp = MCPClient(command=[self.mcp_bin], label="pfodb-mcp")
        await self._mcp.start()
        self._tools = await self._mcp.list_tools()
        log.info(f"pfodb-mcp ready -- tools: {[t['name'] for t in self._tools]}")
        self._ready = True

    async def stop(self):
        if self._mcp:
            await self._mcp.stop()

    def _build_reliability_block(self, tool_calls_log: list) -> str:
        """
        Build a single human-readable reliability statement from PFO data.
        Computed in Python -- the model cannot ignore or omit it.
        """
        pfos = []
        for tc in tool_calls_log:
            if tc["tool"] != "search":
                continue
            try:
                results = json.loads(tc["result"])
                if isinstance(results, list):
                    pfos.extend(results)
            except Exception:
                continue

        if not pfos:
            return ""

        confidences     = [p.get("confidence", 0.0) for p in pfos]
        corroborations  = [p.get("corroboration_count", 0) for p in pfos]
        conflict_counts = [len(p.get("conflict_refs", [])) for p in pfos]
        sources         = list(dict.fromkeys(p.get("source", "?") for p in pfos))

        avg_conf     = sum(confidences) / len(confidences)
        min_conf     = min(confidences)
        total_corr   = sum(corroborations)
        total_conf   = sum(conflict_counts)
        unverified   = sum(1 for c in corroborations if c == 0)
        n            = len(pfos)

        # Confidence label
        if avg_conf >= 0.80:
            conf_label = "HIGH"
        elif avg_conf >= 0.60:
            conf_label = "MODERATE"
        else:
            conf_label = "LOW"

        # Build the statement
        filled = round(avg_conf * 10)
        bar    = "#" * filled + "." * (10 - filled)

        lines = [
            "",
            "--- RELIABILITY ASSESSMENT ---",
            f"Confidence: [{bar}] {avg_conf:.2f} ({conf_label})"
            + (f"  [!] lowest fact: {min_conf:.2f}" if min_conf < avg_conf - 0.1 else ""),
        ]

        # Verification status
        if unverified == n:
            lines.append(
                f"Verification: SINGLE SOURCE ONLY -- none of the {n} facts have been "
                f"independently corroborated. Figures are as reported by the source."
            )
        elif unverified > 0:
            lines.append(
                f"Verification: PARTIAL -- {n - unverified} of {n} facts independently "
                f"corroborated, {unverified} unverified."
            )
        else:
            lines.append(
                f"Verification: CORROBORATED -- all {n} facts confirmed by "
                f"{total_corr} independent source(s)."
            )

        # Conflict status
        if total_conf > 0:
            lines.append(
                f"Conflicts: WARNING -- {total_conf} contradicting claim(s) detected "
                f"in the knowledge base. The answer above may reflect only one side."
            )
        else:
            lines.append("Conflicts: None detected.")

        # Sources
        src_str = ", ".join(sources[:5])
        if len(sources) > 5:
            src_str += f" (+{len(sources)-5} more)"
        lines.append(f"Sources: {src_str}")

        return "\n".join(lines)

    async def ask(self, question: str, verbose: bool = False) -> dict:
        tool_calls_log = []
        ts_start = asyncio.get_event_loop().time()

        async def call_tool(name: str, arguments: dict) -> str:
            result = await self._mcp.call_tool(name, arguments)
            tool_calls_log.append({"tool": name, "args": arguments, "result": result, "result_preview": result[:200]})
            if verbose:
                print_tool_call(name, arguments, result)
            return result

        try:
            answer = await run_agent_loop(
                question     = question,
                system       = SYSTEM_PROMPT,
                tools        = self._tools,
                call_tool_fn = call_tool,
            )
        except Exception as e:
            log.exception("Agent loop error")
            answer = f"Agent error: {e}"

        reliability = self._build_reliability_block(tool_calls_log)
        if reliability:
            answer = answer.rstrip() + "\n" + reliability

        elapsed = round(asyncio.get_event_loop().time() - ts_start, 2)

        # Trim full results for log file to keep it small
        log_calls = [
            {"tool": tc["tool"], "args": tc["args"], "result": tc.get("result_preview", tc["result"][:200])}
            for tc in tool_calls_log
        ]
        entry = {
            "ts":         datetime.utcnow().isoformat(),
            "backend":    "tekmerdb",
            "question":   question,
            "answer":     answer,
            "tool_calls": log_calls,
            "elapsed_s":  elapsed,
        }
        log_path = Path(LOG_DIR) / f"tekmerdb_{datetime.utcnow().strftime('%Y%m%d')}.jsonl"
        with open(log_path, "a") as f:
            f.write(json.dumps(entry) + "\n")

        return {"answer": answer, "tool_calls": log_calls,
                "elapsed_s": elapsed, "backend": "tekmerdb"}


async def cli(args):
    print(f"\n{DIVIDER}")
    print("  ENERGY COMPLIANCE ANALYST  --  TekmerDB")
    print(f"  pfodb-mcp : {args.mcp_bin}")
    print(f"  Ollama    : {OLLAMA_URL}  ({OLLAMA_MODEL})")
    print(DIVIDER)

    agent = TekmerAgent(mcp_bin=args.mcp_bin)
    try:
        await agent.start()
    except Exception as e:
        print(f"\n  ERROR: {e}")
        print("  Is pfodb running on :3000?  Is --mcp-bin path correct?")
        sys.exit(1)

    print(f"\n  Tools: {[t['name'] for t in agent._tools]}")
    print(f"\n{SEP}")
    print("  Type a question. 'quit' to exit.")
    print(SEP)

    while True:
        try:
            question = input("\n  Question> ").strip()
        except (KeyboardInterrupt, EOFError):
            break
        if not question:
            continue
        if question.lower() in ("quit", "exit", "q"):
            break

        print(f"\n{SEP}")
        print(f"  Q: {question}")
        print(SEP)

        result = await agent.ask(question, verbose=True)
        print(f"\n  Answer:\n")
        cprint(result["answer"])
        print(f"\n  [{result['elapsed_s']}s -- TekmerDB backend]")
        print(SEP)

    await agent.stop()
    print(f"\n  Session logs in {LOG_DIR}/")


async def serve(args):
    import uvicorn
    from fastapi import FastAPI, HTTPException
    from pydantic import BaseModel

    app   = FastAPI(title="Energy Compliance Agent -- TekmerDB")
    agent = TekmerAgent(mcp_bin=args.mcp_bin)

    class AskRequest(BaseModel):
        question: str

    @app.on_event("startup")
    async def startup():
        await agent.start()

    @app.on_event("shutdown")
    async def shutdown():
        await agent.stop()

    @app.get("/health")
    async def health():
        return {"status": "ready" if agent._ready else "starting", "backend": "tekmerdb"}

    @app.post("/ask")
    async def ask(req: AskRequest):
        if not req.question.strip():
            raise HTTPException(400, "question cannot be empty")
        if not agent._ready:
            raise HTTPException(503, "agent not ready")
        return await agent.ask(req.question, verbose=False)

    print(f"\n  TekmerDB agent HTTP server on :{args.port}")
    print(f"  pfodb-mcp: {args.mcp_bin}")
    await uvicorn.Server(
        uvicorn.Config(app, host="0.0.0.0", port=args.port, log_level="warning")
    ).serve()


def main():
    parser = argparse.ArgumentParser(description="Energy Compliance Agent -- TekmerDB")
    parser.add_argument("--mcp-bin", required=True, help="Path to pfodb-mcp binary")
    parser.add_argument("--serve",   action="store_true",
                        help="Run as HTTP server on --port instead of interactive CLI")
    parser.add_argument("--port",    type=int, default=8081,
                        help="HTTP server port when --serve is used (default: 8081)")
    args = parser.parse_args()

    if not Path(args.mcp_bin).exists():
        print(f"ERROR: pfodb-mcp not found: {args.mcp_bin}")
        sys.exit(1)

    if args.serve:
        asyncio.run(serve(args))
    else:
        asyncio.run(cli(args))


if __name__ == "__main__":
    main()