FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# chromadb>=1.0.16 and chroma-mcp>=0.2.6 are compatible with each other
# and with chromadb/chroma:latest (1.x server, v2 API)
RUN pip install --no-cache-dir \
    "chromadb>=1.0.16" \
    "chroma-mcp>=0.2.6"

# Show install path so we know where the binary lands
RUN which chroma-mcp

# Agent deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent_rag.py .
COPY mcp_client.py .
COPY ollama_client.py .
COPY server.py .

RUN mkdir -p /app/logs

EXPOSE 8080

CMD ["python", "server.py"]